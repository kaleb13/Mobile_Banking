      "metadata": {
        "supportPhone": "127",
        "ussdCode": "*127#",
        "website": "https://www.ethiotelecom.et/telebirr/"
      },
      "parsing": {
        "securityFilterRegex": "(?i)(?:OTP|verification code|never share|security code)",
        "ignoreFilterRegex": "(?i)(?:airtime package.*(?:successfully bought|unlimited))",
        "patterns": [
          {
            "patternId": "telebirr_airtime_self",
            "name": "Airtime Self Recharge",
            "type": "expense",
            "patternType": "telebirrAirtime",
            "triggerKeywords": ["airtime", "recharged"],
            "regex": "(?i)(?:recharged|bought)\\s+(?:ETB|Birr)?\\s*([0-9,.]+)\\s+airtime.*?balance\\s+is\\s+ETB\\s*([0-9,.]+).*?transaction\\s+(?:number|id|ref)\\s+(?:is\\s+)?([A-Za-z0-9]+)",
            "amountGroup": 1,
            "counterpartyGroup": 0,
            "counterpartyDefault": "Airtime Recharge",
            "balanceGroup": 2,
            "idGroup": 3
          }
        ]
      }
    },
